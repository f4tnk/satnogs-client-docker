SATNOGS_API_TOKEN=
SATNOGS_DB_API_TOKEN=
SATNOGS_ARTIFACTS_API_TOKEN=
SATNOGS_ARTIFACTS_ENABLED=True
SATNOGS_SOAPY_RX_DEVICE=driver=rtlsdr,serial=00003000
SATNOGS_ANTENNA=RX
SATNOGS_RX_SAMP_RATE=2048000
SATNOGS_PPM_ERROR=0

SATNOGS_LO_TRANSVERTER=0
SATNOGS_RF_GAIN =49.6

SATNOGS_WATERFALL_AUTORANGE=True
#SATNOGS_WATERFALL_MIN_VALUE=-90
#SATNOGS_WATERFALL_MAX_VALUE=-60

SATNOGS_STATION_ELEV=52
SATNOGS_STATION_ID=37xx
SATNOGS_STATION_LAT=43.0
SATNOGS_STATION_LON=4.0

SATNOGS_LOG_LEVEL=INFO
SATNOGS_PRE_OBSERVATION_SCRIPT=satnogs-pre {{ID}} {{FREQ}} {{TLE}} {{TIMESTAMP}} {{BAUD}} {{SCRIPT_NAME}} {{MODE}}
SATNOGS_POST_OBSERVATION_SCRIPT=satnogs-post {{ID}} {{FREQ}} {{TLE}} {{TIMESTAMP}} {{BAUD}} {{SCRIPT_NAME}} {{MODE}}

UDP_DUMP_HOST=127.0.0.1 # required, enable UDP output from flowgraphs

SATDUMP_ENABLE=True
SATDUMP_KEEPLOGS=Yes
GRSAT_NEW=Yes
SATNOGS_REMOVE_RAW_FILE=false
SATNOGS_REMOVE_OGG_FILES=false

#SATNOGS_GPSD_CLIENT_ENABLED=True
#SATNOGS_GPSD_TIMEOUT=30
#AUTO_SCHEDULER_EXTRA=-P prio.txt -d 1.2
GRSAT_KEEPLOGS=yes
#DIREWOLF_ENABLE=yes
#DIREWOLF_CONF=/var/lib/satnogs-client/direwolf.conf
ENABLE_IQ_DUMP=True
IQ_DUMP_FILENAME=/tmp/.satnogs/iq.raw
#IQ_DUMP_RENAME=yes
