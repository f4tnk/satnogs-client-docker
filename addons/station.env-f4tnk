SATNOGS_API_TOKEN=XXX
SATNOGS_DB_API_TOKEN=XXX
SATNOGS_ARTIFACTS_API_TOKEN=XXX
SATNOGS_ARTIFACTS_ENABLED=True
#SATNOGS_SOAPY_RX_DEVICE=driver=rtlsdr,serial=00000001
SATNOGS_SOAPY_RX_DEVICE=driver=sdrplay
#SATNOGS_ANTENNA=RX
SATNOGS_ANTENNA=Tuner 1 50 ohm

SATNOGS_RX_SAMP_RATE=2.4e6
#SATNOGS_PPM_ERROR=1

SATNOGS_RF_GAIN=40
#SATNOGS_RF_GAIN=7 CQRX rtl 1000
#SATNOGS_GAIN_MODE="Overall"
#SATNOGS_OTHER_SETTINGS="IFGR=26,RFGR=3"
SATNOGS_WATERFALL_AUTORANGE=true
SATNOGS_RX_BANDWIDTH=300e3
#SATNOGS_WATERFALL_MIN_VALUE=-110
#SATNOGS_WATERFALL_MAX_VALUE=-80

SATNOGS_STATION_ELEV=52
SATNOGS_STATION_ID=3762
SATNOGS_STATION_LAT=43.81477
SATNOGS_STATION_LON=4.06576

SATNOGS_LOG_LEVEL=INFO
SATNOGS_PRE_OBSERVATION_SCRIPT=satnogs-pre {{ID}} {{FREQ}} {{TLE}} {{TIMESTAMP}} {{BAUD}} {{SCRIPT_NAME}} {{MODE}}
SATNOGS_POST_OBSERVATION_SCRIPT=satnogs-post {{ID}} {{FREQ}} {{TLE}} {{TIMESTAMP}} {{BAUD}} {{SCRIPT_NAME}} {{MODE}}

UDP_DUMP_HOST=127.0.0.1  # required, enable UDP output from flowgraphs
METEOR_NORAD=57166 59051 40069 44387  # optional, space separated list of ID's to activate demodulation

SATDUMP_ENABLE=True
SATDUMP_KEEPLOGS=Yes
GRSAT_KEEPLOGS=Yes
GRSAT_NEW=Yes
SATNOGS_REMOVE_OGG_FILES=true

#BANDSCAN_ENABLE=false
#BANDSCAN_FREQ=435000000 # default 401M
#BANDSCAN_SAMPLERATE=2e6 # override the default from SATNOGS_RX_SAMP_RATE
#BANDSCAN_DIR=/srv/bandscan # make sure to bind-mount a path from the host

#SATNOGS_GPSD_CLIENT_ENABLED=True
#SATNOGS_GPSD_TIMEOUT=30
#AUTO_SCHEDULER_EXTRA=-P prio.txt -d 1.2
#GRSAT_KEEPLOGS=yes
#DIREWOLF_ENABLE=yes
#DIREWOLF_CONF=/var/lib/satnogs-client/direwolf.conf
ENABLE_IQ_DUMP=True
IQ_DUMP_FILENAME=/tmp/.satnogs/iq.raw
#IQ_DUMP_RENAME=yes